{
  "name": "jev-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "infra"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @jev/server\" \"npm run dev -w @jev/web\"",
    "build": "npm run build -w @jev/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "check-env": "tsx --env-file=.env scripts/check-env.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "vendor": "tsx scripts/vendor-datasets.ts",
    "cache:clear": "rm -f server/.cache/jev/*.json",
    "latency": "tsx --env-file=.env scripts/latency-probe.ts",
    "warm-cache": "tsx --env-file=.env scripts/warm-cache.ts",
    "a4:merge": "tsx scripts/a4-merge-results.ts",
    "deploy": "npm run build && npm run deploy -w @jev/infra"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  }
}
